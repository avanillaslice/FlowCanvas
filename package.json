{
  "name": "flowcanvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "launch": "node --import tsx scripts/run.ts",
    "up": "node --import tsx scripts/run.ts",
    "stop": "tsx scripts/stop.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mcp:setup": "tsx scripts/setup-mcp.ts",
    "mcp:check": "tsx scripts/probe-mcp.ts",
    "codex:check": "tsx scripts/probe-codex.ts",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "elkjs": "^0.12.0",
    "express": "^5.3.0",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
